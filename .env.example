# API
SECRET_KEY=replace-with-a-long-random-value
TOKEN_EXPIRE_MINUTES=720
APP_TIMEZONE=America/Sao_Paulo
SEED_DEMO_DATA=true

# The demo uses SQLite by default. Relative paths start at the directory from
# which the API process is launched.
DATABASE_URL=sqlite:///./medsync.db

# To use the PostgreSQL service from docker-compose.yml, replace DATABASE_URL
# with the line below after running `docker compose up -d postgres`.
# DATABASE_URL=postgresql+psycopg://medsync:medsync@localhost:5432/medsync
POSTGRES_DB=medsync
POSTGRES_USER=medsync
POSTGRES_PASSWORD=medsync
POSTGRES_PORT=5432

# Web/API integration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api
